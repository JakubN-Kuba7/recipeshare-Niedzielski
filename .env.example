# Supabase project URL used by server-side database and Storage access
SUPABASE_URL=

# Server-only Supabase secret key. Never expose this to browser code.
SUPABASE_SECRET_KEY=

# Optional browser-safe keys for future client-side Supabase features
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
